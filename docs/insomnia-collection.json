        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Northern Wildlife Testing Lab\",\n  \"admin_address\": \"789 Science Blvd, North City, NC 98765\",\n  \"contact_info\": \"Phone: +1-555-0300\",\n  \"email\": \"info@northern-wildlife-lab.example.com\",\n  \"authorized_for_trichinella\": true,\n  \"authorized_for_asf\": true\n}"
