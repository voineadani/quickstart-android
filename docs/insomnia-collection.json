{
  "_type": "export",
  "__export_format": 4,
  "resources": [
    {
      "_type": "request_group",
      "name": "Hunting Data System API",
      "description": "Complete API collection for the Hunting Data System",
      "environment": {},
      "metaSortKey": -1000000000000
    },
    {
      "_type": "request_group",
      "parentId": "wrk_hunting_data",
      "name": "Authentication",
      "description": "User authentication endpoints"
    },
    {
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Register User",
      "method": "POST",
      "url": "{{ base_url }}/auth/register",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Hunter\",\n  \"username\": \"jhunter2\",\n  \"phone\": \"+1-555-4000\",\n  \"email\": \"jane.hunter@example.com\",\n  \"password\": \"password123\",\n  \"role_id\": 1\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Login",
      "method": "POST",
      "url": "{{ base_url }}/auth/login",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"admin@hunting-data.example.com\",\n  \"password\": \"password\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Get Current User",
      "method": "GET",
      "url": "{{ base_url }}/me",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ token }}"
        }
      ]
    },
    {
      "_type": "request",
      "parentId": "fld_auth",
      "name": "Logout",
      "method": "POST",
      "url": "{{ base_url }}/auth/logout",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ token }}"
        }
      ]
    },
    {
      "_type": "request_group",
      "parentId": "wrk_hunting_data",
      "name": "Protocols",
      "description": "Protocol management endpoints"
    },
    {
      "_type": "request",
      "parentId": "fld_protocols",
      "name": "List Protocols",
      "method": "GET",
      "url": "{{ base_url }}/protocols",
