      "parentId": "fld_protocols",
      "name": "Create Protocol",
      "method": "POST",
      "url": "{{ base_url }}/protocols",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"game_species\": \"White-tailed Deer\",\n  \"animal_sex\": \"M\",\n  \"animal_age\": \"3 years\",\n  \"animal_weight\": 85.5,\n  \"sample_type\": \"muscle tissue\",\n  \"sample_barcode\": \"WTD-2025-001\",\n  \"category\": \"Regular Season\",\n  \"phone_from\": \"+1-555-6789\",\n  \"gps_lat\": 45.4215,\n  \"gps_lon\": -75.6972,\n  \"admin_address\": \"Ottawa, Ontario, Canada\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ token }}"
        }
      ]
    },
    {
      "_type": "request",
      "parentId": "fld_protocols",
      "name": "Get Protocol Details",
      "method": "GET",
      "url": "{{ base_url }}/protocols/1",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{ token }}"
        }
      ]
    },
    {
      "_type": "request",
      "parentId": "fld_protocols",
      "name": "Assign Lab to Protocol (Admin)",
      "method": "POST",
      "url": "{{ base_url }}/protocols/1/assign-lab",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"lab_id\": 1\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ token }}"
        }
      ]
    },
    {
      "_type": "request_group",
      "parentId": "wrk_hunting_data",
